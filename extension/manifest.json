{
  "manifest_version": 3,
  "name": "shadertoy2mc",
  "version": "1.1.0",
  "description": "Download any ShaderToy shader as a Minecraft post-effect resource pack ZIP.",
  "permissions": [
    "activeTab",
    "scripting",
    "downloads"
  ],
  "host_permissions": [
    "https://www.shadertoy.com/*"
  ],
  "background": {
    "type": "module",
    "scripts": ["background.js"]
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "48": "icons/icon-48.png",
      "96": "icons/icon-96.png"
    }
  },
  "icons": {
    "48": "icons/icon-48.png",
    "96": "icons/icon-96.png"
  }
}
